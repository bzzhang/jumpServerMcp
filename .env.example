# 通用配置（在 MCP 客户端的 env 中或 .env 文件里设置）
JUMPSERVER_URL=http://your-jumpserver:8001
JUMPSERVER_USERNAME=your-username
JUMPSERVER_PASSWORD=your-password
# 可选：组织 ID，不填则自动获取当前组织
JUMPSERVER_ORG_ID=
# 可选：跳板机 SSH 主机与端口，不填则取 JUMPSERVER_URL 的 host
JUMPSERVER_SSH_HOST=
JUMPSERVER_SSH_PORT=2222
DB_COMMAND_TIMEOUT=30
DB_MAX_ROWS=500
# 可选：直连服务器备用通道（跳板机未授权主机资产时使用），JSON 数组
# SERVER_DIRECT_SSH=[{"name":"app1","host":"192.168.1.10","port":22,"username":"root","password":"xxx"}]
SERVER_DIRECT_SSH=
